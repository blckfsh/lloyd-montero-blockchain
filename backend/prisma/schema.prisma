datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_DATABASE_URL")
}

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

model Balance {
  id            Int    @id() @default(autoincrement())
  walletAddress String @unique()
  balance       Float
  tokenBalance  Float?
}
